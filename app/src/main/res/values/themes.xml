<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background must match the Compose light scheme background:
         nav transitions alpha-blend both screens, so any mismatch bleeds
         through as a flash. -->
    <style name="Theme.JourneyRecorder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>