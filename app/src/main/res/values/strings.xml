    <!-- Guide -->
    <string name="guide_top_bar_title">Recording guide</string>
    <string name="guide_back">Back</string>
    <string name="guide_section_ids_title">Why are element IDs sometimes missing?</string>
    <string name="guide_section_ids_body">Journey Recorder reads the accessibility tree of the app you record. Whether an element has a stable ID depends entirely on how the target app was built. When IDs are missing, steps fall back to text, content descriptions and screen coordinates — the exported markdown marks those steps so your automation can use text-based selectors instead.</string>
    <string name="guide_fw_classic_name">Classic Android (XML Views)</string>
    <string name="guide_fw_classic_summary">Full element IDs (e.g. com.app:id/login_button), text and descriptions. Best possible recording quality.</string>
    <string name="guide_fw_compose_name">Jetpack Compose</string>
    <string name="guide_fw_compose_summary">No element IDs — Compose UIs are not built from Views, so there is nothing to report. Button text and content descriptions still come through and work well as locators.</string>
    <string name="guide_fw_compose_tip">For your own apps: set Modifier.semantics { testTagsAsResourceId = true } on the root composable and add Modifier.testTag(\"…\") to key elements — their tags then appear as element IDs when recording.</string>
    <string name="guide_fw_flutter_name">Flutter</string>
    <string name="guide_fw_flutter_summary">No element IDs, ever — Flutter draws its own UI and only exposes what the app labels with Semantics. Labeled buttons and visible text are captured; unlabeled icons show as coordinates only.</string>
    <string name="guide_fw_flutter_tip">For your own apps: wrap key widgets in Semantics(label: \"…\") — labels are captured as content descriptions.</string>
    <string name="guide_fw_rn_name">React Native</string>
    <string name="guide_fw_rn_summary">No element IDs — testID is invisible to accessibility on Android. Visible text and accessibilityLabel values are captured and usually make good locators.</string>
    <string name="guide_fw_rn_tip">For your own apps: set accessibilityLabel on touchable elements — it is captured as a content description.</string>
    <string name="guide_fw_webview_name">WebView / Ionic / Cordova</string>
    <string name="guide_fw_webview_summary">HTML id attributes usually appear as element IDs, plus link and button text. The tree can be briefly empty right after a page loads — pause a moment before tapping.</string>
    <string name="guide_fw_games_name">Games / Unity / canvas UIs</string>
    <string name="guide_fw_games_summary">No accessibility tree at all — taps inside these apps cannot be captured.</string>
    <string name="guide_section_tips_title">Tips for reliable recordings</string>
    <string name="guide_tip_deliberate">Tap deliberately, one action at a time — rapid taps can merge.</string>
    <string name="guide_tip_gestures">Swipes, pinch and drag gestures are not captured — only taps, typing and scrolls. Add a note manually to the markdown if a flow needs one.</string>
    <string name="guide_tip_review">Review the journey before exporting: typed values are shown in the step list with a redact button — remove anything sensitive.</string>
    <string name="guide_tip_masking">Passwords and fields that look sensitive (PIN, OTP, CVV, card number) are masked automatically and never stored.</string>
    <string name="guide_tip_banking">Some banking apps block accessibility services entirely and cannot be recorded.</string>
    <string name="guide_tip_recovered">If the recorder stops unexpectedly (battery managers can kill it), the journey is kept and marked \"recovered\".</string>
    <string name="guide_badge_full">full IDs</string>
    <string name="guide_badge_partial">text locators</string>
    <string name="guide_badge_none">not recordable</string>

